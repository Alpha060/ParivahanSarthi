# Server Port & Environment
PORT=5000
NODE_ENV=development

# Neon / PostgreSQL Database Connection (Pooled connection for server queries, Direct for migrations)
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@<HOST>-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:<PASSWORD>@<HOST>.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Frontend API Base URL
VITE_API_URL="/api"
